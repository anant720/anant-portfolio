# ============================================================
# ANANT SUTHAR PORTFOLIO — ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# ============================================================

# ─────────────────────────────────────────────
# SUPABASE (required)
# Get these from https://supabase.com/dashboard → Project Settings → API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ─────────────────────────────────────────────
# GITHUB API (optional but recommended)
# Prevents rate limiting (5000 req/hr authenticated vs 60 unauthenticated)
# Create at: https://github.com/settings/tokens → Fine-grained token
# Scopes needed: public_repo (read only)
# ─────────────────────────────────────────────
GITHUB_TOKEN=github_pat_your_token_here

# ─────────────────────────────────────────────
# ADMIN DASHBOARD (required for /admin)
# Set a strong random secret. Never commit this.
# Generate: openssl rand -hex 32
# ─────────────────────────────────────────────
ADMIN_SECRET=your-super-secret-admin-password

# ─────────────────────────────────────────────
# CONTACT FORM EMAIL (optional)
# Get API key from https://resend.com
# NOTIFY_EMAIL: the email address to receive contact form submissions
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
NOTIFY_EMAIL=your@email.com

# ─────────────────────────────────────────────
# VERCEL ANALYTICS
# Automatically enabled when deployed to Vercel — no key needed
# ─────────────────────────────────────────────
